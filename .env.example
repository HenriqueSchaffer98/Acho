APP_NAME=Acho
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://acho.test
APP_BASE_DOMAIN=acho.test
APP_PORT=80

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Banco de Dados (PostgreSQL 16 via Sail) ─────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=acho
DB_SUPERUSER=sail               # Postgres superuser — usado apenas pelo container no boot
DB_USERNAME=acho_app            # Role da aplicação (sem BYPASSRLS) — todas as requests HTTP
DB_USERNAME_MIGRATOR=acho_migrator  # Role privilegiada (BYPASSRLS) — migrations e seeds
DB_PASSWORD=password
FORWARD_DB_PORT=5432

# ─── Sessão / Cache / Queue ──────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# ─── Redis (via Sail) ────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

# ─── E-mail (Mailpit via Sail) ───────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@acho.com.br"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# ─── Vite ────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173

# ─── Sail ────────────────────────────────────────────────────────────────────
WWWGROUP=1000
WWWUSER=1000
SAIL_XDEBUG_MODE=off

# ─── Storage — Cloudflare R2 (produção) ──────────────────────────────────────
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Segurança ───────────────────────────────────────────────────────────────
# Hash de senha: Argon2id + Pepper (ADR-023).
# Gerar com: openssl rand -base64 48
# NUNCA commitar o valor real. Em prod: armazenar em vault (Forge env).
APP_PEPPER=
HASH_DRIVER=argon2id-pepper
HASH_ARGON_MEMORY=65536
HASH_ARGON_THREADS=1
HASH_ARGON_TIME=4

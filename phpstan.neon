includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - app

    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Falsos positivos conhecidos do skeleton Laravel
        - '#Call to an undefined method Illuminate\\.*#'
        - '#Access to an undefined property Illuminate\\.*#'

        # spatie/laravel-data — classe não encontrada antes de composer install.
        # Remover esta entrada após rodar: sail composer install
        - '#Class Spatie\\LaravelData\\Data#'

    excludePaths:
        - vendor
        - storage
        - bootstrap/cache
